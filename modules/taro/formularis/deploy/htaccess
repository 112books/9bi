<IfModule mod_rewrite.c>
  RewriteEngine On
  # El repòtex del certificat (Let's Encrypt) ha de poder passar per http
  RewriteRule ^\.well-known/ - [L]

  # ⚠ Tria el domini abans de pujar-ho: substitueix exemple.org pel teu.
  #   Sense https no hi ha enviament segur.
  #
  # ⚠ Les DUES condicions han de ser certes per redirigir, i això és el que
  #   evita el bucle de 301, segons on acabi el TLS:
  #     · TLS a Apache      → %{HTTPS} és on           → no redirigeix
  #     · TLS al frontal    → X-Forwarded-Proto: https → no redirigeix
  #     · http de debon      → les dues amb http        → redirigeix
  #   Amb una sola condició, en un hosting on Apache rep el TLS directament,
  #   el %{HTTPS} sol no hi és i el bucle és garantit.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://exemple.org/$1 [R=301,L,QSA]

  # Tot el reste va al procés Python (port de deploy/start.sh)
  RewriteRule ^(.*)$ http://127.0.0.1:8302/$1 [P,QSA,L]
</IfModule>
